{
	"schemaVersion": 1,
	"id": "organicallymod",
	"version": "${version}",
	"name": "Organically Mod",
	"description": "Mod that aims to add neat additions to various vanilla biomes and regions",
	"authors": [
		"Eravern"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/organicallymod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.eravern.organically.OrganicallyMod"
		],
		"fabric-datagen": [
			"net.eravern.organically.OrganicallyModDataGenerator"
		],
		"client": [
			"net.eravern.organically.OrganicallyModClient"
		]
	},
	"mixins": [
		"organicallymod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
